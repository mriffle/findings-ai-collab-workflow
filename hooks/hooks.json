{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly_data.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly_data.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_findings.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_findings.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_promotion.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_promotion.py"] }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly_data.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly_data.py"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_promotion.py"] },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard_promotion.py"] }
        ]
      }
    ]
  }
}
